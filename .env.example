# System 1 (fast UI actions): TypeSafe Jev. Leave empty to run the planner alone.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Below this confidence Jev hands the decision back to the planner instead of acting.
FAST_MIN_CONFIDENCE=0.4
# Text helper: writes the value whenever Jev chooses TYPE_TEXT. Claude Haiku via ANTHROPIC_API_KEY by default;
# TEXT_MODEL_PROVIDER=openrouter uses the model below instead.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5

# Claude API directly (recommended). When set, the planner and the text helper use Claude
# (claude-haiku-5-5 by default; Sonnet 5.5 and Opus 5.5 are selectable in the console).
ANTHROPIC_API_KEY=
# Override with LLM_PROVIDER=openrouter / TEXT_MODEL_PROVIDER=openrouter to use the settings below instead.

# System 2 (planner) provider when not using Anthropic: OpenAI-compatible chat completions with tool calling. Keys stay on the server.
# OpenRouter is the default; Anthropic's OpenAI-compatible endpoint (https://api.anthropic.com/v1) also works.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated; the first is the default, the rest are selectable in the console.
LLM_MODELS=anthropic/claude-haiku-5.5,inception/mercury-2.5,anthropic/claude-sonnet-5.5,google/gemini-3.7-flash
# The planner reads the indexed element list, not screenshots. 1 attaches a screenshot only when that
# text failed it (repeated errors, or a click that changed nothing); 0 never sends one.
AGENT_VISION=0

# Limits per run and per server.
MAX_STEPS=60
MAX_RUN_SECONDS=900
MAX_SESSIONS=3
MAX_RUN_COST_USD=3.0
MAX_SOCKETS_PER_IP=4
# Close an idle browser (and free its slot) this long after a run ends.
IDLE_CLOSE_SECONDS=300
# The browser refuses private/internal addresses (SSRF guard). Set to 1 only for local testing.
ALLOW_PRIVATE_NETWORK=0

# Browser. Leave BROWSER_WS_URL empty to launch the bundled headless Chromium,
# or point it at a hosted CDP endpoint (Browserbase, Steel, Browserless…).
BROWSER_WS_URL=
HEADLESS=1
START_PAGE_URL=https://www.bing.com/
SEARCH_URL=https://www.bing.com/search?q={}

HOST=0.0.0.0
PORT=8766
# Extra origins allowed to open the WebSocket (same-origin and localhost are always allowed).
ALLOWED_ORIGINS=
WEB_DIST=apps/web/out
